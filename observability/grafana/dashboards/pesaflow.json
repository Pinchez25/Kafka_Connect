      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(kafka_stream_task_dropped_records_total{job=\"pesaflow-streams\"}[5m]))",
          "legendFormat": "dropped / 5 min",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
