namespace com.pinchez.cdc;

// Optional: main schema (using it creates a .avsc equivalent file)
schema Transaction;

record Transaction {
    uuid id;
    string created_at;
    uuid? from_account_id = null;
    uuid? to_account_id = null;
    uuid? merchant_id = null;
    decimal(19, 2) amount;
    string reference;
    string type;
    string? agent_number = null;
    string currency;
    string status;
    string? failure_reason = null;
    string? __op = null;
    long? __source_ts_ms = null;
}

record Account {
    uuid id;
    string created_at;
    string updated_at;
    long version;
    decimal(19, 2) daily_limit;
    string phone_number;
    string full_name;
    string kyc_level;
    string status;
    string? __op = null;
    long? __source_ts_ms = null;
}

record Merchant {
    uuid id;
    string created_at;
    string till_number;
    string name;
    string category;
    string? __op = null;
    long? __source_ts_ms = null;
}
