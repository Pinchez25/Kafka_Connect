{
  "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
  "tasks.max": "1",
  "exactly.once.support": "required",
  "database.hostname": "postgres",
  "database.port": "5432",
  "database.user": "pesaflow",
  "database.password": "${env:PESAFLOW_DB_PASSWORD}",
  "database.dbname": "pesaflow",
  "topic.prefix": "pesaflow",
  "plugin.name": "pgoutput",
  "slot.name": "pesaflow_source",
  "publication.name": "pesaflow_cdc",
  "publication.autocreate.mode": "disabled",
  "table.include.list": "public\\.(accounts|merchants|transactions|debezium_signals)",
  "snapshot.mode": "initial",
  "heartbeat.interval.ms": "10000",
  "signal.enabled.channels": "source",
  "signal.data.collection": "public.debezium_signals",
  "column.mask.hash.v2.SHA-256.with.salt.pesaflow-cdc": "public.accounts.phone_number",
  "key.converter": "org.apache.kafka.connect.storage.StringConverter",
  "value.converter": "io.confluent.connect.avro.AvroConverter",
  "value.converter.schema.registry.url": "http://schema-registry:8081",
  "topic.creation.groups": "entities",
  "topic.creation.default.partitions": "3",
  "topic.creation.default.replication.factor": "1",
  "topic.creation.entities.include": "pesaflow\\.(accounts|merchants)",
  "topic.creation.entities.partitions": "3",
  "topic.creation.entities.replication.factor": "1",
  "topic.creation.entities.cleanup.policy": "compact",
  "transforms": "unwrap,route,dropSignals,extractKey,nameAccount,nameMerchant,nameTransaction",
  "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
  "transforms.unwrap.delete.tombstone.handling.mode": "tombstone",
  "transforms.unwrap.add.fields": "op,source.ts_ms",
  "transforms.route.type": "org.apache.kafka.connect.transforms.RegexRouter",
  "transforms.route.regex": "pesaflow\\.public\\.(.*)",
  "transforms.route.replacement": "pesaflow.$1",
  "transforms.dropSignals.type": "org.apache.kafka.connect.transforms.Filter",
  "transforms.dropSignals.predicate": "isSignalTopic",
  "transforms.extractKey.type": "org.apache.kafka.connect.transforms.ExtractField$Key",
  "transforms.extractKey.field": "id",
  "transforms.extractKey.predicate": "isTableTopic",
  "transforms.nameAccount.type": "org.apache.kafka.connect.transforms.SetSchemaMetadata$Value",
  "transforms.nameAccount.schema.name": "com.pinchez.cdc.Account",
  "transforms.nameAccount.predicate": "isAccountsTopic",
  "transforms.nameMerchant.type": "org.apache.kafka.connect.transforms.SetSchemaMetadata$Value",
  "transforms.nameMerchant.schema.name": "com.pinchez.cdc.Merchant",
  "transforms.nameMerchant.predicate": "isMerchantsTopic",
  "transforms.nameTransaction.type": "org.apache.kafka.connect.transforms.SetSchemaMetadata$Value",
  "transforms.nameTransaction.schema.name": "com.pinchez.cdc.Transaction",
  "transforms.nameTransaction.predicate": "isTransactionsTopic",
  "predicates": "isSignalTopic,isTableTopic,isAccountsTopic,isMerchantsTopic,isTransactionsTopic",
  "predicates.isSignalTopic.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
  "predicates.isSignalTopic.pattern": "pesaflow\\.debezium_signals",
  "predicates.isTableTopic.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
  "predicates.isTableTopic.pattern": "pesaflow\\.(accounts|merchants|transactions)",
  "predicates.isAccountsTopic.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
  "predicates.isAccountsTopic.pattern": "pesaflow\\.accounts",
  "predicates.isMerchantsTopic.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
  "predicates.isMerchantsTopic.pattern": "pesaflow\\.merchants",
  "predicates.isTransactionsTopic.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
  "predicates.isTransactionsTopic.pattern": "pesaflow\\.transactions"
}
