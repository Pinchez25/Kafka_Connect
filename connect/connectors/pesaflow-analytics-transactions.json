{
  "connector.class": "io.debezium.connector.jdbc.JdbcSinkConnector",
  "tasks.max": "3",
  "topics": "pesaflow.transactions.enriched",
  "connection.url": "jdbc:postgresql://postgres:5432/pesaflow",
  "connection.username": "pesaflow",
  "connection.password": "${env:PESAFLOW_DB_PASSWORD}",
  "insert.mode": "upsert",
  "primary.key.mode": "record_value",
  "primary.key.fields": "transaction_id",
  "schema.evolution": "basic",
  "collection.name.format": "analytics.transactions",
  "key.converter": "org.apache.kafka.connect.storage.StringConverter",
  "value.converter": "io.confluent.connect.avro.AvroConverter",
  "value.converter.schema.registry.url": "http://schema-registry:8081",
  "transforms": "dropCdcHeaders,snakeCase,occurredAt",
  "transforms.dropCdcHeaders.type": "org.apache.kafka.connect.transforms.DropHeaders",
  "transforms.dropCdcHeaders.headers": "__op,__source_lsn",
  "transforms.snakeCase.type": "org.apache.kafka.connect.transforms.ReplaceField$Value",
  "transforms.snakeCase.renames": "transactionId:transaction_id,accountId:account_id,counterpartyAccountId:counterparty_account_id,occurredAt:occurred_at,kycLevel:kyc_level,accountStatus:account_status,accountAgeSeconds:account_age_seconds,merchantId:merchant_id,merchantCategory:merchant_category",
  "transforms.occurredAt.type": "org.apache.kafka.connect.transforms.TimestampConverter$Value",
  "transforms.occurredAt.field": "occurred_at",
  "transforms.occurredAt.target.type": "Timestamp",
  "transforms.occurredAt.unix.precision": "microseconds",
  "errors.tolerance": "all",
  "errors.log.enable": "true",
  "errors.deadletterqueue.topic.name": "pesaflow.dlq.analytics-transactions",
  "errors.deadletterqueue.topic.replication.factor": "1",
  "errors.deadletterqueue.context.headers.enable": "true"
}
