{
  "connector.class": "io.debezium.connector.jdbc.JdbcSinkConnector",
  "tasks.max": "3",
  "topics": "pesaflow.accounts,pesaflow.balances",
  "consumer.override.isolation.level": "read_committed",
  "connection.url": "jdbc:postgresql://postgres:5432/pesaflow",
  "connection.username": "pesaflow",
  "connection.password": "${env:PESAFLOW_DB_PASSWORD}",
  "insert.mode": "upsert",
  "delete.enabled": "true",
  "primary.key.mode": "record_key",
  "primary.key.fields": "account_id",
  "schema.evolution": "basic",
  "collection.name.format": "analytics.${topic}",
  "key.converter": "org.apache.kafka.connect.storage.StringConverter",
  "value.converter": "io.confluent.connect.avro.AvroConverter",
  "value.converter.schema.registry.url": "http://schema-registry:8081",
  "transforms": "dropCdcHeaders,keyStruct,accountColumns,balanceColumns,balanceUpdatedAt,route",
  "transforms.dropCdcHeaders.type": "org.apache.kafka.connect.transforms.DropHeaders",
  "transforms.dropCdcHeaders.headers": "__op,__source_lsn",
  "transforms.keyStruct.type": "org.apache.kafka.connect.transforms.HoistField$Key",
  "transforms.keyStruct.field": "account_id",
  "transforms.accountColumns.type": "org.apache.kafka.connect.transforms.ReplaceField$Value",
  "transforms.accountColumns.exclude": "id,__op,__source_ts_ms",
  "transforms.accountColumns.predicate": "isAccounts",
  "transforms.balanceColumns.type": "org.apache.kafka.connect.transforms.ReplaceField$Value",
  "transforms.balanceColumns.renames": "entryCount:entry_count,lastTransactionId:last_transaction_id,updatedAt:updated_at",
  "transforms.balanceColumns.predicate": "isBalances",
  "transforms.balanceUpdatedAt.type": "org.apache.kafka.connect.transforms.TimestampConverter$Value",
  "transforms.balanceUpdatedAt.field": "updated_at",
  "transforms.balanceUpdatedAt.target.type": "Timestamp",
  "transforms.balanceUpdatedAt.unix.precision": "microseconds",
  "transforms.balanceUpdatedAt.predicate": "isBalances",
  "transforms.route.type": "org.apache.kafka.connect.transforms.RegexRouter",
  "transforms.route.regex": "pesaflow\\.(.*)",
  "transforms.route.replacement": "$1",
  "predicates": "isAccounts,isBalances",
  "predicates.isAccounts.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
  "predicates.isAccounts.pattern": "pesaflow\\.accounts",
  "predicates.isBalances.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
  "predicates.isBalances.pattern": "pesaflow\\.balances",
  "errors.tolerance": "all",
  "errors.log.enable": "true",
  "errors.deadletterqueue.topic.name": "pesaflow.dlq.analytics-accounts",
  "errors.deadletterqueue.topic.replication.factor": "1",
  "errors.deadletterqueue.context.headers.enable": "true"
}
